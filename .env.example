# Скопируйте в .env и заполните. .env не коммитится.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Временно: доступ без входа (в dev по умолчанию true). Для включения защиты — false.
OPEN_ACCESS=true

# PostgreSQL + pgvector
POSTGRES_DB=ntrace
POSTGRES_USER=ntrace
POSTGRES_PASSWORD=ntrace
DATABASE_URL=postgres://ntrace:ntrace@localhost:5432/ntrace

# Redis (брокер Celery)
REDIS_URL=redis://localhost:6379/0

# User-agent исследовательского бота (README §4)
CRAWLER_USER_AGENT=NTraceResearchBot/0.1 (+mailto:change-me@example.org)

# Telegram-бот для уведомлений о поломках сбора (README §4.2); пусто — только панель
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SITE_URL=http://localhost:8000
